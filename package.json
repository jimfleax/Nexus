{
  "name": "nexus-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:all": "npm run test --workspaces --if-present",
    "build:all": "npm run build --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "typecheck:ci": "npm run build --workspace=packages/shared && npm run typecheck:all",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2"
  }
}
