{
  "name": "nexus-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:all": "npm run test --workspaces --if-present",
    "build:all": "npm run build --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "typecheck:ci": "npm run build --workspace=packages/shared && npm run typecheck:all",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "patch-package": "^8.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "fast-uri": "^4.2.3",
    "follow-redirects": "^1.16.2",
    "ip-address": "^10.7.5",
    "postcss-selector-parser": "^6.1.5",
    "source-map-js": "^1.2.2",
    "systeminformation": "^5.33.19",
    "typescript": "^5.9.3",
    "undici": "^8.12.3",
    "vite": "^8.3.5"
  }
}
