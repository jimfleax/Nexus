npx lint-staged
npm run lint:all
npm run test:all

# Prevent .env files from being committed
if git diff --cached --name-only | grep -E '\.env$|\.env\.[a-zA-Z0-9_-]+$' | grep -v '\.example$'; then
  echo "❌ ERROR: You are trying to commit a .env file!"
  echo "Please unstage the .env file to continue."
  exit 1
fi
