{
  "name": "@nexus/api",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "npm run build --workspace=@nexus/shared --if-present && node build.js",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "typecheck": "npm run build --workspace=@nexus/shared --if-present && tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@nexus/shared": "*",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "googleapis": "^180.0.0",
    "jose": "^6.2.13",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "form-data": "^4.0.6",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  }
}
