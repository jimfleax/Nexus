# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexus?appName=Local

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ── Auth.js / JWT ─────────────────────────────────────────────────────────────
AUTH_SECRET=<32-char-random-secret>


# ── Google OAuth ──────────────────────────────────────────────────────────────
AUTH_GOOGLE_ID=<google-oauth-client-id>.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-<google-oauth-client-secret>
TOKEN_ENCRYPTION_KEY=my-super-secret-encryption-key-for-local-dev-32
